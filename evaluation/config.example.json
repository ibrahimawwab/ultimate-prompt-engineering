{
  "settings": {
    "temperature": 0,
    "max_tokens": 400
  },
  "timeout_seconds": 60,
  "models": [
    {
      "name": "openai-model-placeholder",
      "provider": "openai_chat_completions",
      "base_url": "https://api.openai.com/v1/chat/completions",
      "model": "replace-with-exact-model-id",
      "model_version": "record-exact-snapshot-or-not-disclosed",
      "api_key_env": "OPENAI_API_KEY",
      "input_cost_per_1m_tokens": null,
      "output_cost_per_1m_tokens": null
    },
    {
      "name": "anthropic-model-placeholder",
      "provider": "anthropic_messages",
      "base_url": "https://api.anthropic.com/v1/messages",
      "model": "replace-with-exact-model-id",
      "model_version": "record-exact-version-or-not-disclosed",
      "api_version": "2023-06-01",
      "api_key_env": "ANTHROPIC_API_KEY",
      "input_cost_per_1m_tokens": null,
      "output_cost_per_1m_tokens": null
    },
    {
      "name": "google-model-placeholder",
      "provider": "google_generative_language",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
      "model": "replace-with-exact-model-id",
      "model_version": "record-exact-version-or-not-disclosed",
      "api_key_env": "GOOGLE_API_KEY",
      "input_cost_per_1m_tokens": null,
      "output_cost_per_1m_tokens": null
    }
  ]
}
